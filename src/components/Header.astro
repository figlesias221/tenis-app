---
import { ARCHIVE_RANGE_LABEL, RANKINGS_AS_OF_LABEL } from "@/lib/archive";

const path = Astro.url.pathname;
const nav = [
  { href: "/clutch", label: "Clutch Index" },
  { href: "/rankings", label: "Rankings" },
  { href: "/competitions", label: "Tournaments" },
  { href: "/head-to-head", label: "Head to Head" },
];
const isActive = (href: string) =>
  path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<!-- The card's header block: who scored it, what it covers, and the stamp. -->
<header class="border-b-2 border-rule">
  <div class="page flex flex-wrap items-start justify-between gap-4 py-4">
    <div>
      <a href="/" class="no-underline">
        <span class="font-mono text-[0.75rem] font-extrabold uppercase tracking-[-0.02em] text-ink">
          The Tennis Almanac
        </span>
      </a>
      <p class="text-note mt-1">Chair card · ATP singles</p>
    </div>

    <p class="stamp mt-0.5 shrink-0">Break point</p>

    {/* The card's filing details. Deliberately does NOT import clutch data:
        Header is inside Layout, so anything it imports is bundled into the SSR
        worker for every route, prerendered or not. */}
    <p class="text-note hidden shrink-0 text-right leading-relaxed lg:block">
      Seasons {ARCHIVE_RANGE_LABEL}<br />
      Rankings to the {RANKINGS_AS_OF_LABEL}
    </p>
    <p class="text-note shrink-0 text-right lg:hidden">{ARCHIVE_RANGE_LABEL}</p>
  </div>

  <nav aria-label="Sections" class="page border-t border-grid">
    <ul class="segbar overflow-x-auto" style="scrollbar-width:none">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["seg block", isActive(item.href) && "seg-on"]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
