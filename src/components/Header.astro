---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { ARCHIVE_RANGE_LABEL, RANKINGS_AS_OF_LABEL } from "@/lib/archive";

const path = Astro.url.pathname;

const nav = [
  { href: "/rankings", label: "Rankings" },
  { href: "/competitions", label: "Tournaments" },
  { href: "/head-to-head", label: "Head to Head" },
  { href: "/clutch", label: "Clutch Index" },
];

const isActive = (href: string) =>
  path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<header>
  <div class="page">
    <!-- Masthead -->
    <div class="flex items-baseline justify-between gap-4 py-4">
      <div class="flex items-baseline gap-4">
        <a href="/" class="font-display text-[1.375rem] font-semibold tracking-[-0.02em] text-ink no-underline">
          The Tennis Almanac
        </a>
        <span class="hidden h-4 w-px bg-rule sm:inline-block" aria-hidden="true"></span>
        <p class="text-kicker hidden sm:block">
          ATP · {ARCHIVE_RANGE_LABEL} · Rankings to the {RANKINGS_AS_OF_LABEL}
        </p>
      </div>
      <ThemeToggle />
    </div>

    <!-- Sections -->
    <nav aria-label="Sections" class="border-y-[1px] border-b-rule border-t-ink border-t-2">
      <ul class="segbar -mb-px flex gap-x-6 overflow-x-auto border-b-0 py-0.5" style="scrollbar-width:none">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["seg block py-2", isActive(item.href) && "seg-on"]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
