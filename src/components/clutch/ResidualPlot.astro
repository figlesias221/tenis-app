---
/**
 * The argument, drawn.
 *
 * Each player is a dot at (what the era model expected of him, what he actually
 * did). The dashed line is the model. The stem joining the two IS the Clutch
 * Index — so the quantity being ranked is visible rather than asserted.
 *
 * Server-rendered SVG. No library, no client JS.
 */
import type { ClutchPlayer } from "@/lib/clutch/types";

interface Props {
  players: ClutchPlayer[];
  labelled: ClutchPlayer[];
  component: "serve" | "return";
  xLabel: string;
  yLabel: string;
}

const { players, labelled, component, xLabel, yLabel } = Astro.props;

const pts = players
  .filter((p) => p.c[component].n > 0)
  .map((p) => ({ p, x: p.c[component].e, y: p.c[component].r }));

const W = 760;
const H = 430;
const PAD = { top: 18, right: 22, bottom: 48, left: 60 };

const xs = pts.map((d) => d.x);
const ys = pts.map((d) => d.y);
const span = (v: number[], f: number) => {
  const lo = Math.min(...v), hi = Math.max(...v), m = (hi - lo) * f;
  return [lo - m, hi + m] as const;
};
const [x0, x1] = span(xs, 0.07);
const [y0, y1] = span(ys, 0.07);

const sx = (v: number) => PAD.left + ((v - x0) / (x1 - x0)) * (W - PAD.left - PAD.right);
const sy = (v: number) => H - PAD.bottom - ((v - y0) / (y1 - y0)) * (H - PAD.top - PAD.bottom);

const ticks = (lo: number, hi: number, n = 4) =>
  Array.from({ length: n + 1 }, (_, i) => lo + ((hi - lo) * i) / n);

const labelledIds = new Set(labelled.map((p) => p.id));

/* Dodge labels apart, and flip them left near the right edge. */
const LH = 14;
let lastY = -Infinity;
const marks = pts
  .filter((d) => labelledIds.has(d.p.id))
  .map((d) => ({ d, cx: sx(d.x), cy: sy(d.y), my: sy(d.x) }))
  .sort((a, b) => a.cy - b.cy)
  .map((m) => {
    const ly = Math.max(m.cy + 4, lastY + LH);
    lastY = ly;
    return { ...m, ly, flip: m.cx > W - PAD.right - 120 };
  });

const surname = (n: string) => n.split(" ").slice(-1)[0];
---

<figure>
  <div class="table-scroll border border-rule bg-sheet-2 p-4">
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" style="min-width:560px" role="img"
      aria-label={`${pts.length} players plotted as ${yLabel} against ${xLabel}. The dashed line is the model; each stem is one player's residual.`}>

      {ticks(y0, y1).map((t) => (
        <g>
          <line x1={PAD.left} x2={W - PAD.right} y1={sy(t)} y2={sy(t)} stroke="rgb(var(--grid))" stroke-width="1" />
          <text x={PAD.left - 10} y={sy(t) + 4} text-anchor="end" font-size="10"
            fill="rgb(var(--ink-3))" font-family="var(--font-num)">{(t * 100).toFixed(0)}%</text>
        </g>
      ))}
      {ticks(x0, x1).map((t) => (
        <text x={sx(t)} y={H - PAD.bottom + 20} text-anchor="middle" font-size="10"
          fill="rgb(var(--ink-3))" font-family="var(--font-num)">{(t * 100).toFixed(0)}%</text>
      ))}

      <line x1={PAD.left} x2={W - PAD.right} y1={H - PAD.bottom} y2={H - PAD.bottom} stroke="rgb(var(--rule))" />
      <line x1={PAD.left} x2={PAD.left} y1={PAD.top} y2={H - PAD.bottom} stroke="rgb(var(--rule))" />

      <!-- What ordinary play alone predicts -->
      <line x1={sx(x0)} y1={sy(x0)} x2={sx(x1)} y2={sy(x1)}
        stroke="rgb(var(--ink))" stroke-width="1.5" stroke-dasharray="7 5"></line>

      <!-- The cloud -->
      {pts.filter((d) => !labelledIds.has(d.p.id)).map((d) => (
        <circle cx={sx(d.x)} cy={sy(d.y)} r="2.4" fill="rgb(var(--ink-3) / 0.5)" />
      ))}

      <!-- The extremes, with their residual drawn as a stem to the model -->
      {marks.map(({ d, cx, cy, my, ly, flip }) => {
        const up = d.p.c[component].z >= 0;
        const tone = up ? "rgb(var(--above))" : "rgb(var(--below))";
        return (
          <g>
            <line x1={cx} y1={cy} x2={cx} y2={my} stroke={tone} stroke-width="1.5" />
            <circle cx={cx} cy={cy} r="4" fill={tone} stroke="rgb(var(--sheet-2))" stroke-width="1.5" />
            {/* Stroked in the panel colour and painted stroke-first, so the
                label knocks out the model line rather than being crossed by it. */}
            <text x={cx + (flip ? -9 : 9)} y={ly} font-size="10.5" text-anchor={flip ? "end" : "start"}
              fill="rgb(var(--ink))" font-family="var(--font-num)"
              stroke="rgb(var(--sheet-2))" stroke-width="3.5" paint-order="stroke"
              stroke-linejoin="round">{surname(d.p.name)}</text>
          </g>
        );
      })}

      <text x={(W + PAD.left) / 2} y={H - 8} text-anchor="middle" font-size="10"
        fill="rgb(var(--ink-3))" font-family="var(--font-num)">{xLabel}</text>
      <text x="15" y={(H - PAD.bottom + PAD.top) / 2}
        transform={`rotate(-90 15 ${(H - PAD.bottom + PAD.top) / 2})`} text-anchor="middle"
        font-size="10" fill="rgb(var(--ink-3))" font-family="var(--font-num)">{yLabel}</text>
    </svg>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1">
    <span class="text-note"><span class="mr-1.5 inline-block h-2 w-2 align-middle" style="background:rgb(var(--above))"></span>Above the model</span>
    <span class="text-note"><span class="mr-1.5 inline-block h-2 w-2 align-middle" style="background:rgb(var(--below))"></span>Below the model</span>
    <span class="text-note"><span class="mr-1.5 inline-block h-px w-4 align-middle" style="background:rgb(var(--ink))"></span>Predicted by ordinary play</span>
  </div>
  <figcaption class="text-note mt-2 max-w-[62ch]">
    Each of the {pts.length} dots is a qualifying career. The stem is the distance
    from the model — that distance, and nothing else, is what this page ranks.
  </figcaption>
</figure>
