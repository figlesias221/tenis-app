---
/**
 * The page's argument, drawn.
 *
 * Every qualifying player is one dot: how well he served on ordinary points
 * against how often he saved break points. The fitted line is what serve
 * quality alone predicts. The vertical distance from a dot to that line IS
 * the Clutch Index. Labelled dots are the extremes.
 *
 * One series, so no legend: the axis titles name what is plotted.
 */
import type { ClutchPlayer } from "@/lib/clutch/types";

interface Props {
  players: ClutchPlayer[];
  labelled: ClutchPlayer[];
  xLabel: string;
  yLabel: string;
  component: "serve" | "return";
}

const { players, labelled, xLabel, yLabel, component } = Astro.props;

const W = 720;
const H = 420;
const PAD = { top: 16, right: 20, bottom: 46, left: 58 };

const pts = players
  .filter((p) => p.c[component].n > 0)
  .map((p) => ({
    p,
    x: component === "serve"
      ? p.c.serve.n > 0 ? xOf(p) : 0
      : xOf(p),
    y: p.c[component].r,
  }));

function xOf(p: ClutchPlayer): number {
  // The predictor is recoverable from the stored observed and expected rates
  // plus the pooled fit, but the simplest honest x here is the expected rate,
  // which is a monotone function of the predictor.
  return p.c[component].e;
}

const xs = pts.map((d) => d.x);
const ys = pts.map((d) => d.y);
const pad = (v: number[], f: number) => {
  const lo = Math.min(...v);
  const hi = Math.max(...v);
  const m = (hi - lo) * f;
  return [lo - m, hi + m] as const;
};
const [x0, x1] = pad(xs, 0.06);
const [y0, y1] = pad(ys, 0.06);

const sx = (v: number) =>
  PAD.left + ((v - x0) / (x1 - x0)) * (W - PAD.left - PAD.right);
const sy = (v: number) =>
  H - PAD.bottom - ((v - y0) / (y1 - y0)) * (H - PAD.top - PAD.bottom);

// The model line: expected == observed, i.e. exactly as predicted.
const line = { a: sx(x0), b: sy(x0), c: sx(x1), d: sy(x1) };

const ticks = (lo: number, hi: number, n = 4) =>
  Array.from({ length: n + 1 }, (_, i) => lo + ((hi - lo) * i) / n);

const labelledIds = new Set(labelled.map((p) => p.id));

/**
 * Nudge labels apart vertically so they never overlap, and flip them to the
 * left of their dot near the right edge so they do not run off the plot.
 * Screenshotting the first version showed "Nadal" sitting on top of
 * "Ivanisevic"; this is the fix.
 */
const LABEL_H = 13;
const placed = pts
  .filter((d) => labelledIds.has(d.p.id))
  .map((d) => ({ d, cx: sx(d.x), cy: sy(d.y) }))
  .sort((a, b) => a.cy - b.cy);

let lastY = -Infinity;
const labels = placed.map(({ d, cx, cy }) => {
  const ly = Math.max(cy, lastY + LABEL_H);
  lastY = ly;
  const flip = cx > W - PAD.right - 110;
  return { d, cx, cy, ly, flip };
});
---

<figure class="mt-4">
  <div class="table-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img"
      aria-label={`Scatter of ${yLabel} against ${xLabel} for ${pts.length} players, with the line showing what serve quality alone predicts.`}
      style="min-width:520px">

      <!-- Grid, recessive -->
      {ticks(y0, y1).map((t) => (
        <g>
          <line x1={PAD.left} x2={W - PAD.right} y1={sy(t)} y2={sy(t)}
            stroke="rgb(var(--rule))" stroke-width="1" />
          <text x={PAD.left - 8} y={sy(t) + 4} text-anchor="end"
            fill="rgb(var(--ink-3))" font-size="11" class="font-ui">
            {(t * 100).toFixed(0)}%
          </text>
        </g>
      ))}
      {ticks(x0, x1).map((t) => (
        <text x={sx(t)} y={H - PAD.bottom + 18} text-anchor="middle"
          fill="rgb(var(--ink-3))" font-size="11" class="font-ui">
          {(t * 100).toFixed(0)}%
        </text>
      ))}

      <!-- Axes -->
      <line x1={PAD.left} x2={W - PAD.right} y1={H - PAD.bottom} y2={H - PAD.bottom}
        stroke="rgb(var(--rule-strong))" stroke-width="1"></line>
      <line x1={PAD.left} x2={PAD.left} y1={PAD.top} y2={H - PAD.bottom}
        stroke="rgb(var(--rule-strong))" stroke-width="1"></line>

      <!-- What serve quality alone predicts -->
      <line x1={line.a} y1={line.b} x2={line.c} y2={line.d}
        stroke="rgb(var(--ink))" stroke-width="2" stroke-dasharray="5 4"></line>

      <!-- The cloud -->
      {pts.filter((d) => !labelledIds.has(d.p.id)).map((d) => (
        <circle cx={sx(d.x)} cy={sy(d.y)} r="2.5"
          fill="rgb(var(--ink-3) / 0.45)" />
      ))}

      <!-- The extremes, ringed in the surface colour so they separate -->
      {labels.map(({ d, cx, cy, ly, flip }) => (
        <g>
          {Math.abs(ly - cy) > 2 && (
            <line x1={cx + (flip ? -6 : 6)} y1={cy} x2={cx + (flip ? -10 : 10)} y2={ly - 3.5}
              stroke="rgb(var(--rule-strong))" stroke-width="1" />
          )}
          <circle cx={cx} cy={cy} r="4.5"
            fill={d.p.c[component].z >= 0 ? "rgb(var(--positive))" : "rgb(var(--negative))"}
            stroke="rgb(var(--paper))" stroke-width="2" />
          <text x={cx + (flip ? -10 : 10)} y={ly} font-size="11"
            text-anchor={flip ? "end" : "start"}
            fill="rgb(var(--ink))" class="font-ui">
            {d.p.name.split(" ").slice(-1)[0]}
          </text>
        </g>
      ))}

      <text x={(W + PAD.left) / 2} y={H - 6} text-anchor="middle"
        font-size="11" fill="rgb(var(--ink-3))" class="font-ui">{xLabel}</text>
      <text x="14" y={(H - PAD.bottom + PAD.top) / 2}
        transform={`rotate(-90 14 ${(H - PAD.bottom + PAD.top) / 2})`}
        text-anchor="middle" font-size="11" fill="rgb(var(--ink-3))"
        class="font-ui">{yLabel}</text>
    </svg>
  </div>
  <figcaption class="text-note mt-2">
    Each dot is one of the {pts.length} qualifying players. The dashed line is what
    ordinary play alone predicts. The vertical distance from a dot to that line is
    what this page ranks.
  </figcaption>
</figure>
