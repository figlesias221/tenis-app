---
import { normalizeCountryCode, getFlagAlt, getFlagUrl, hasFlagSupport } from "@/lib/utils/flags";

export interface Props {
  countryCode: string;
  nationality?: string;
  size?: "small" | "medium" | "large";
  className?: string;
}

const { countryCode, nationality, size = "medium", className = "" } = Astro.props;

const sizeClasses = {
  small: "w-5 h-4",
  medium: "w-6 h-4",
  large: "w-8 h-6",
};

const normalizedCode = normalizeCountryCode(countryCode);
const hasFlag = hasFlagSupport(normalizedCode);
const flagPath = getFlagUrl(normalizedCode, size);
const altText = getFlagAlt(countryCode, nationality);
---

{/*
  Rendered up to ~2,200 times on a ranking page, so the markup is kept lean:
  whether a flag exists is known at build time, so only one branch ships, with
  no inline error handler and no hidden fallback alongside it.
*/}
{
  hasFlag ? (
    <img
      src={flagPath}
      alt={altText}
      class:list={[sizeClasses[size], className, "object-cover border border-grid"]}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span
      class:list={["text-note inline-flex items-center justify-center border border-grid text-ink-3", sizeClasses[size], className]}
      title={altText}
    >
      {normalizedCode}
    </span>
  )
}
