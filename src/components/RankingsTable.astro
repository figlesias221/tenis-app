---
import type { Rankings } from "@/lib/api/types";
import CountryFlag from "./CountryFlag.astro";
import { RANKINGS_AS_OF_LABEL } from "@/lib/archive";

export interface Props {
  rankings: Rankings;
  currentPage?: number;
  pageSize?: number;
}

const { rankings, currentPage = 1, pageSize = 100 } = Astro.props;

const urlParams = new URLSearchParams(Astro.url.search);
const buildPageUrl = (page: number) => {
  const p = new URLSearchParams(urlParams);
  p.set("page", String(page));
  return `?${p.toString()}`;
};

const total = rankings.rankings.length;
const totalPages = Math.max(1, Math.ceil(total / pageSize));
const start = (currentPage - 1) * pageSize;
// A ranking week holds ~2,200 players. Nobody reads that as one block, so the
// page shows the top 100 and folds the rest away - still present, still
// searchable in-page, just not a wall.
const VISIBLE = 100;
const all = rankings.rankings;
const rows = all.slice(0, VISIBLE);
const rest = all.slice(VISIBLE);

// A short window of pages around the current one.
const window = 5;
let first = Math.max(1, currentPage - Math.floor(window / 2));
const last = Math.min(totalPages, first + window - 1);
first = Math.max(1, last - window + 1);
const pages = Array.from({ length: last - first + 1 }, (_, i) => first + i);

const fmt = (n: number) => n.toLocaleString("en-GB");

---

<div class="table-scroll">
  <table class="table table--tight table--sticky">
    <caption class="text-note">
      Top {VISIBLE} of {fmt(total)} · standings as at the {RANKINGS_AS_OF_LABEL}
    </caption>
    <thead>
      <tr>
        <th class="col-rank" scope="col">#</th>
        <th class="col-name" scope="col">Player</th>
        <th class="col-meta col-hide-sm" scope="col">Country</th>
        <th class="col-num" scope="col">Points</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((entry) => {
          return (
            <tr>
              <td class="col-rank">{entry.rank}</td>
              <td class="col-name">
                <a class="link" href={`/player/${entry.player.id}`}>{entry.player.name}</a>
              </td>
              <td class="col-meta col-hide-sm">
                <span class="inline-flex items-baseline gap-1.5">
                  <CountryFlag
                    countryCode={entry.player.countryCode}
                    nationality={entry.player.nationality}
                    size="small"
                  />
                  {entry.player.nationality}
                </span>
              </td>
              <td class="col-num">{fmt(entry.points)}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

{
  rest.length > 0 && (
    <details class="methodology mt-4">
      <summary>Show the other {rest.length.toLocaleString("en-GB")} ranked players</summary>
      <div class="table-scroll mt-3">
        <table class="table table--tight">
          <tbody>
            {rest.map((entry) => (
              <tr>
                <td class="col-rank">{entry.rank}</td>
                <td class="col-name">
                  <a class="link" href={`/player/${entry.player.id}`}>{entry.player.name}</a>
                </td>
                <td class="col-meta col-hide-sm">{entry.player.nationality}</td>
                <td class="col-num">{fmt(entry.points)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )
}

