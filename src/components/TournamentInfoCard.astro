---
import type { EnhancedCompetitionDisplay } from '@/lib/api/official-types';
import { CompetitionFormatter } from '@/lib/utils/competition-formatter';

interface Props {
  tournament: EnhancedCompetitionDisplay;
  showDetails?: boolean;
}

const { tournament, showDetails = true } = Astro.props;

const levelColor = CompetitionFormatter.getLevelColor(tournament.level.toLowerCase().replace(/\s+/g, '_'));
const surfaceKey = CompetitionFormatter.getSurfaceKey(tournament.surface || "Hard");
const isEstimatedPrize = !tournament.prizeMoney || tournament.prizeMoney.currency === 'USD';
---

<div class="bg-court border border-line p-6">
  <!-- Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h2 class="text-xl font-bold text-chalk mb-1">
        {tournament.name}
      </h2>
      <div class="flex items-center gap-2 text-sm text-chalk-2">
        <span class={`font-medium ${levelColor}`}>
          {tournament.level}
        </span>
        <span>•</span>
        <span>{tournament.category}</span>
        <span>•</span>
        <span>{tournament.gender}</span>
        <span>{tournament.type}</span>
      </div>
    </div>

    <!-- Status Badge -->
    {tournament.status && (
      <div class={`px-2 py-1 text-xs font-medium ${ tournament.status ==='active' ? 'bg-above text-above' :
        tournament.status === 'delayed' ? 'bg-clay text-clay' :
        tournament.status === 'cancelled' ? 'bg-below dark:bg-below text-below dark:text-below' :
        'bg-court-2 text-chalk'
      }`}>
        {tournament.status.charAt(0).toUpperCase() + tournament.status.slice(1)}
      </div>
    )}
  </div>

  {showDetails && (
    <!-- Tournament Details Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
      <!-- Surface -->
      <div class="flex items-center gap-2">
        <span class="text-xl"><span class={`swatch swatch--${surfaceKey}`}></span></span>
        <div>
          <div class="text-xs text-chalk-3">Surface</div>
          <div class="font-medium text-chalk">
            {tournament.surface || 'Hard'}
          </div>
        </div>
      </div>

      <!-- Prize Money -->
      {tournament.prizeMoney && (
        <div class="flex items-center gap-2">
          <span class="text-xl">💰</span>
          <div>
            <div class="text-xs text-chalk-3">
              Prize {isEstimatedPrize ? '(Est.)' : ''}
            </div>
            <div class="font-medium text-chalk">
              {CompetitionFormatter.formatPrizeMoney(tournament.prizeMoney, isEstimatedPrize)}
            </div>
          </div>
        </div>
      )}

      <!-- Tournament ID -->
      <div class="flex items-center gap-2">
        <span class="text-xl">🆔</span>
        <div>
          <div class="text-xs text-chalk-3">ID</div>
          <div class="font-mono text-xs text-chalk-2">
            {tournament.id.replace('sr:competition:', '')}
          </div>
        </div>
      </div>

      <!-- Parent Tournament -->
      {tournament.parentTournament && (
        <div class="flex items-center gap-2">
          <span class="text-xl">🏆</span>
          <div>
            <div class="text-xs text-chalk-3">Tournament</div>
            <div class="font-medium text-chalk">
              {tournament.parentTournament.name}
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Venue Information -->
    {tournament.venue && (
      <div class="border-t border-line pt-4">
        <h3 class="font-semibold text-chalk mb-2 flex items-center gap-2">
          <span class="text-lg">🏟️</span>
          Venue Information
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-chalk-3">Complex:</span>
            <span class="ml-2 font-medium text-chalk">
              {tournament.venue.complex}
            </span>
          </div>
          {tournament.venue.maxCapacity && (
            <div>
              <span class="text-chalk-3">Capacity:</span>
              <span class="ml-2 font-medium text-chalk">
                {tournament.venue.maxCapacity.toLocaleString()}
                {tournament.venue.reducedCapacity && (
                  <span class="text-clay ml-1">(Reduced)</span>
                )}
              </span>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Data Source -->
    <div class="border-t border-line pt-3 mt-4">
      <p class="text-xs text-chalk-3">
        Tournament data from Jeff Sackmann's ATP Tennis Database
        {isEstimatedPrize && tournament.prizeMoney && (
          <span class="ml-1">• Prize money estimated based on tournament level</span>
        )}
      </p>
    </div>
  )}
</div>