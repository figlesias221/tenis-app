---
// import PlayerImage from "./PlayerImage.astro";

export interface Props {
  playerId: string;
  playerName: string;
  limit?: number;
}

const { limit = 3 } = Astro.props;

// Note: In a real application, this would fetch actual match data from the API
// For now, we'll show a message that match data isn't available
const matches: any[] = [];
---

<div class="bg-white border border-rule p-4">
  <h3 class="font-semibold text-ink mb-4">Recent Matches</h3>

  {matches.length > 0 ? (
    <div class="space-y-3">
      {matches.map((match) => (
        <div class="flex items-center gap-3 p-3 bg-paper">
          <div class="text-sm text-ink-2">
            Match data would appear here
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="text-center py-8">
      <div class="text-3xl mb-2">🎾</div>
      <p class="text-ink-2 text-sm mb-2">
        Recent match data not available
      </p>
      <p class="text-ink-3 text-xs">
        Match history would be displayed here with real API data
      </p>
    </div>
  )}
</div>