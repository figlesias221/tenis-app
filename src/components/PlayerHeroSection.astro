---
import CountryFlag from "./CountryFlag.astro";
import type { CompetitorProfile } from "@/lib/api/types";
import { MATCH_SEASONS_LABEL } from "@/lib/archive";

export interface Props {
  profile: CompetitorProfile;
  player: {
    id: string;
    name: string;
    nationality: string;
    countryCode: string;
    abbreviation?: string;
  };
  tourType?: "ATP" | "WTA";
  currentRank?: number;
}

const { profile, player, currentRank } = Astro.props;

/**
 * Born-on date, not age. This is an archive: an age computed from today's
 * clock would keep ticking upward for players who stopped playing years ago.
 */
function born(dob?: string): string | null {
  if (!dob) return null;
  const d = new Date(dob);
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
}

const info = profile.info ?? {};
const dob = born(info.date_of_birth);
const hand = info.handedness
  ? `${info.handedness.toLowerCase().startsWith("l") ? "Left" : "Right"}-handed`
  : null;
const height = info.height ? `${info.height} cm` : null;
const best = info.highest_singles_ranking;

const facts = [
  currentRank ? { k: "Rank at cutoff", v: `#${currentRank}` } : null,
  dob ? { k: "Born", v: dob } : null,
  hand ? { k: "Plays", v: hand } : null,
  height ? { k: "Height", v: height } : null,
  best ? { k: "Career high", v: `#${best}` } : null,
].filter(Boolean) as { k: string; v: string }[];
---

<section class="border-b border-grid">
  <div class="page py-9">
    <p class="text-kicker">Player · {MATCH_SEASONS_LABEL}</p>

    <h1 class="text-heading-1 mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <CountryFlag
        countryCode={player.countryCode}
        nationality={player.nationality}
        size="large"
      />
      <span>{player.name}</span>
    </h1>

    {
      facts.length > 0 && (
        <dl class="cells mt-6" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
          {facts.map((f) => (
            <div class="cell">
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
