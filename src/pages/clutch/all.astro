---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import ClutchTable from "@/components/clutch/ClutchTable.astro";
import { career, meta } from "@/lib/clutch/data";

const fmt = (n: number) => n.toLocaleString("en-GB");
const eras = ["all", ...[...new Set(career.map((p) => p.era))].sort()];
---

<Layout
  title="The Clutch Index, full list — The Tennis Almanac"
  description={`All ${career.length} qualifying players ranked by clutch rating, ${meta.seasons[0]}–${meta.seasons[1]}.`}
>
  <div class="page py-10">
    <p class="text-kicker">The Clutch Index · full list</p>
    <h1 class="text-heading-1 mt-2 text-balance">All {career.length} players</h1>
    <p class="text-body-large measure mt-4">
      Every player who cleared the qualification thresholds, ranked. Sort by any
      column; click a row for the breakdown.
      <a class="link" href="/clutch">Back to the findings ›</a>
    </p>

    <div class="dl--inline mt-6 border-y border-grid py-3">
      <div class="dl-row"><dt class="dl-term">Players</dt><dd class="dl-value">{fmt(career.length)}</dd></div>
      <div class="dl-row"><dt class="dl-term">Seasons</dt><dd class="dl-value">{meta.seasons[0]}–{meta.seasons[1]}</dd></div>
      <div class="dl-row"><dt class="dl-term">Matches</dt><dd class="dl-value">{fmt(meta.matchesUsed)}</dd></div>
    </div>

    <nav class="segbar mt-6 border-b border-grid" aria-label="Filter by era">
      {
        eras.map((era) => (
          <a href="#" data-era-filter={era} class:list={["seg", era === "all" && "seg-on"]}>
            {era === "all" ? "All eras" : era}
          </a>
        ))
      }
    </nav>
    <p class="text-note mb-3 mt-2">
      Era filters hide rows. They never re-rank: a player's rating is his
      standing against his own contemporaries either way.
    </p>

    <ClutchTable players={career} weights={meta.weights} />
  </div>
</Layout>
