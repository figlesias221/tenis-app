---
import Layout from "@/layouts/Layout.astro";
import TournamentInfoCard from "@/components/TournamentInfoCard.astro";
import type { CompetitionInfoResponse } from "@/lib/api/official-types";
import { CompetitionFormatter } from "@/lib/utils/competition-formatter";
import { buildTournament } from "@/lib/utils/tournament-detail";
import { LocalDatasetProvider } from "@/lib/api/tennisApi";

export const prerender = true;

/** One page per tournament in the archive. */
export async function getStaticPaths() {
  const provider = new LocalDatasetProvider("./data");
  const comps = await provider.getCompetitionsByCategory("ATP");
  const ids = new Set<string>(
    (comps?.competitions ?? []).map((c: { id: string }) => c.id),
  );
  return [...ids].map((id) => ({ params: { id } }));
}

const id = Astro.params.id!;

let tournamentData: CompetitionInfoResponse | null = null;
let error: string | null = null;

try {
  // Built directly rather than fetched from this site's own API: a page
  // cannot call its own origin once the site is static.
  tournamentData = await buildTournament(id);
  if (!tournamentData) error = "not-found";
} catch (e) {
  error = "not-found";
}

const tournament = tournamentData ? CompetitionFormatter.formatCompetitionInfo(tournamentData) : null;
---

<Layout
  title={tournament ? `${tournament.name} - Tournament Info` : "Tournament Info"}
  description={tournament ? `Details about ${tournament.name} tournament including surface, prize money, and venue information.` : "Tournament information"}
>

  <div class="max-w-6xl mx-auto px-4 py-4">
      <!-- Back Navigation -->
      <div class="mb-4">
        <a href="/competitions" class="btn-outline">‹ All tournaments</a>
      </div>

      <!-- Error State -->
      {error && (
        <div class="panel bg-below dark:bg-below/20 border-below p-4 text-center">
          <div class="text-2xl mb-2"></div>
          <h2 class="text-heading-3">This tournament isn't in the archive</h2>
          <p class="note measure mx-auto mt-2">
            Tournaments here are compiled from match records, so an event only
            appears in the years it was actually played.
          </p>
          <a href="/competitions" class="btn-outline mt-4">Browse all tournaments</a>
        </div>
      )}

      <!-- Tournament Information -->
      {tournament && (
        <div class="space-y-4">
          <!-- Main Tournament Card -->
          <TournamentInfoCard tournament={tournament} />

          <!-- Children Tournaments -->
          {tournamentData?.competition.children && tournamentData.competition.children.length > 0 && (
            <div class="panel p-4">
              <h3 class="text-lg font-semibold mb-3">Tournament Events</h3>
              <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3">
                {tournamentData.competition.children.map((child) => {
                  const childDisplay = CompetitionFormatter.formatCompetitionInfo({
                    generated_at: tournamentData.generated_at,
                    competition: child.competition,
                    info: undefined
                  });

                  return (
                    <a
                      href={`/tournament/${child.competition.id}`}
                      class="block p-3 bg-sheet hover:bg-sheet-2 transition-colors"
                    >
                      <div class="font-medium text-ink mb-1 text-sm">
                        {childDisplay.name}
                      </div>
                      <div class="text-xs text-ink-2 flex items-center gap-1">
                        <span class={CompetitionFormatter.getLevelColor(childDisplay.level.toLowerCase().replace(/\s+/g, '_'))}>
                          {childDisplay.level}
                        </span>
                        <span>•</span>
                        <span>{childDisplay.gender} {childDisplay.type}</span>
                      </div>
                      <div class="text-xs text-ink-3 mt-1">
                        <span class={`swatch swatch--${CompetitionFormatter.getSurfaceKey(childDisplay.surface ||"Hard")}`}></span> {childDisplay.surface || "Hard"}
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Tournament Quick Stats -->
          <div class="panel p-4">
            <h3 class="text-lg font-semibold mb-3">Tournament Details</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-sheet p-3">
                <h4 class="font-medium text-ink mb-2 text-sm">Classification</h4>
                <div class="space-y-1 text-xs">
                  <div class="flex justify-between">
                    <span class="text-ink-2">Level:</span>
                    <span class={`font-medium ${CompetitionFormatter.getLevelColor(tournament.level.toLowerCase().replace(/\s+/g,'_'))}`}>
                      {tournament.level}
                    </span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-ink-2">Category:</span>
                    <span class="font-medium">{tournament.category}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-ink-2">Type:</span>
                    <span class="font-medium">{tournament.gender} {tournament.type}</span>
                  </div>
                </div>
              </div>

              <div class="bg-sheet p-3">
                <h4 class="font-medium text-ink mb-2 text-sm">Playing Conditions</h4>
                <div class="space-y-1 text-xs">
                  <div class="flex justify-between">
                    <span class="text-ink-2">Surface:</span>
                    <span class="font-medium flex items-center gap-1">
                      <span class={`swatch swatch--${CompetitionFormatter.getSurfaceKey(tournament.surface ||"Hard")}`}></span>
                      {tournament.surface || 'Hard'}
                    </span>
                  </div>
                  {tournament.venue && (
                    <div class="flex justify-between">
                      <span class="text-ink-2">Venue:</span>
                      <span class="font-medium truncate">{tournament.venue.complex}</span>
                    </div>
                  )}
                </div>
              </div>

              <div class="bg-sheet p-3">
                <h4 class="font-medium text-ink mb-2 text-sm">Prize Information</h4>
                <div class="text-xs">
                  {tournament.prizeMoney ? (
                    <div class="flex justify-between">
                      <span class="text-ink-2">Prize Pool:</span>
                      <span class="font-medium text-above">
                        {CompetitionFormatter.formatPrizeMoney(tournament.prizeMoney, !tournament.prizeMoney || tournament.prizeMoney.currency === 'USD')}
                      </span>
                    </div>
                  ) : (
                    <div class="text-ink-3">Not available</div>
                  )}
                </div>
              </div>
            </div>
          </div>

          <!-- API Information -->
          <div class="bg-sheet p-3">
            <div class="text-xs text-ink-2 space-y-1">
              <p><strong>ID:</strong> {tournament.id}</p>
              <p><strong>Source:</strong> Jeff Sackmann's ATP Tennis Database</p>
              <p><strong>Updated:</strong> {tournamentData ? new Date(tournamentData.generated_at).toLocaleString() : 'Unknown'}</p>
              {tournament.prizeMoney && tournament.prizeMoney.currency === 'USD' && (
                <p><strong>Note:</strong> Prize estimates based on tournament level</p>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>