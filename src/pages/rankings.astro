---
import Layout from "@/layouts/Layout.astro";
import RankingsTable from "@/components/RankingsTable.astro";
import Select from "@/components/Select.astro";
import { formatDate } from "@/lib/utils/csv-parser";
import { tennisApi } from "@/lib/api/tennisApi";
import { RANKINGS_AS_OF_LABEL } from "@/lib/archive";

const currentPage = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const selectedDate = Astro.url.searchParams.get("date") ?? undefined;

let rankings;
let error: string | undefined;
let availableDates: string[] = [];

try {
  availableDates = await tennisApi.getAvailableRankingDates();
  // The dataset is ATP singles only, so there is no tour toggle to offer.
  rankings = await tennisApi.getATPRankings(undefined, selectedDate);
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to load rankings";
  console.error("Rankings page error:", e);
}

/** The dataset stores ranking dates as YYYYMMDD, not ISO. */
const formatWeek = (raw: string) => {
  const iso = formatDate(raw);
  const d = new Date(`${iso}T00:00:00Z`);
  if (Number.isNaN(d.getTime())) return raw;
  return d.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
};

const heading = selectedDate
  ? `ATP Rankings — week of ${formatWeek(selectedDate)}`
  : `ATP Rankings — ${RANKINGS_AS_OF_LABEL}`;
---

<Layout
  title="ATP Rankings — The Tennis Almanac"
  description={`Every ranked ATP player as at the ${RANKINGS_AS_OF_LABEL}.`}
>
  <div class="page py-10">
    <p class="text-kicker">Rankings</p>
    <h1 class="text-heading-1 mt-2 text-balance">{heading}</h1>
    <p class="text-body-large measure mt-4">
      Every ranked player in the final published list of 2024. Choose an earlier
      week to see the table as it stood then.
    </p>

    {
      availableDates.length > 1 && (
        <form method="get" class="mt-6 flex flex-wrap items-end gap-3">
          <Select
            name="date"
            label="Ranking week"
            class="min-w-[15rem]"
            options={[
              { value: "", label: "Final week of 2024", selected: !selectedDate },
              ...availableDates.map((d) => ({
                value: d,
                label: formatWeek(d),
                selected: d === selectedDate,
              })),
            ]}
          />
          <button type="submit" class="btn-outline">Show</button>
        </form>
      )
    }

    <section class="section">
      {
        error ? (
          <p class="note note--error">{error}</p>
        ) : rankings && rankings.rankings.length > 0 ? (
          <RankingsTable rankings={rankings} currentPage={currentPage} />
        ) : (
          <p class="note">No ranking data for this week.</p>
        )
      }
    </section>
  </div>
</Layout>
