---
import Layout from "@/layouts/Layout.astro";
import PlayerHeroSection from "@/components/PlayerHeroSection.astro";
import StatsVisualization from "@/components/StatsVisualization.astro";
import PlayerMatchRecord from "@/components/PlayerMatchRecord.astro";
import { tennisApi } from "@/lib/api/tennisApi";
import { LocalDatasetProvider } from "@/lib/api/tennisApi";
import type { CompetitorProfile } from "@/lib/api/types";

const provider = new LocalDatasetProvider("./data");

export const prerender = true;

/**
 * Every player with at least one match in the archive gets a page, so the
 * opponent links in a match record never lead anywhere missing.
 */
export function getStaticPaths() {
  // Astro hoists getStaticPaths, so it cannot see consts from the component
  // script; the provider is created here.
  return new LocalDatasetProvider("./data")
    .getAllPlayerIds()
    .map((id) => ({ params: { id } }));
}

interface PlayerData {
  id: string;
  name: string;
  nationality: string;
  countryCode: string;
  abbreviation?: string;
}



const id = Astro.params.id!;

let profile: CompetitorProfile | null = null;
let error: string | null = null;

let record: ReturnType<LocalDatasetProvider["getPlayerRecord"]> = { seasons: [], recent: [] };

try {
  profile = await tennisApi.getCompetitorProfile(id);
  record = provider.getPlayerRecord(id, 10);
} catch (e) {
  error = "not-found";
  console.error("Player profile error:", e);
}

let player: PlayerData | null = null;
let tourType: 'ATP' | 'WTA' = 'ATP';
let currentRank: number | undefined;

if (profile) {
  player = {
    id: profile.id,
    name: profile.name,
    nationality: profile.country,
    countryCode: profile.country_code,
    abbreviation: profile.abbreviation
  };

  tourType = profile.gender === 'female' ? 'WTA' : 'ATP';
  currentRank = profile.competitor_rankings.find(r => r.type === 'singles')?.rank;
}
---

<Layout title={profile ? `${profile.name} - Player Profile` : "Player Profile"} description={profile ? `Detailed profile for tennis player ${profile.name}` : "Player profile information"}>

  {error ? (
    <!-- Error State -->
    <div class="min-h-screen flex items-center justify-center px-4">
      <div class="bg-below dark:bg-below/20 border border-below p-6 text-center max-w-md mx-auto">
        <h2 class="text-heading-3">This player isn't in the archive</h2>
        <p class="note measure mx-auto mt-2">
          The archive covers players who appear in a tour-level match between
          1991 and 2024. Anyone outside that won't have a page here.
        </p>
        <a href="/rankings" class="btn-outline mt-4">Browse the rankings</a>
      </div>
    </div>
  ) : profile ? (
    <!-- Main Content -->
    <div>
      <!-- Hero Section -->
      <PlayerHeroSection
        profile={profile}
        player={player!}
        tourType={tourType}
        currentRank={currentRank}
      />

      <div class="page pb-12">
        <StatsVisualization profile={profile} />
        <PlayerMatchRecord seasons={record.seasons} recent={record.recent} />

        <section class="section">
          <div class="section-head"><p class="text-kicker">Compare</p></div>
          <p class="text-body-small">
            <a class="link" href={`/head-to-head?p1=${profile.id}`}>
              Head-to-head record against another player &rsaquo;
            </a>
          </p>
        </section>
      </div>
    </div>
  ) : null}
</Layout>