---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import Select from "@/components/Select.astro";
import { LocalDatasetProvider } from "@/lib/api/tennisApi";
import { MATCH_SEASONS_LABEL } from "@/lib/archive";

/**
 * Rendered as a static page. The player list is baked in at build time and the
 * comparison is done in the browser against one prerendered JSON file per
 * player, so nothing here needs a server.
 *
 * This replaces a version that built result markup with unescaped innerHTML
 * and could only offer the top 50 players.
 */
const provider = new LocalDatasetProvider("./data");
const roster = provider.getPlayerDirectory();

const options = roster.map((p) => ({
  value: p.id,
  label: `${p.name} · ${p.matches} matches`,
  selected: false,
}));
---

<Layout
  title="Head to Head — The Tennis Almanac"
  description={`The complete meeting record between any two players in the archive, ${MATCH_SEASONS_LABEL}.`}
>
  <div class="page py-10">
    <p class="text-kicker">Head to Head</p>
    <h1 class="text-heading-1 mt-2 text-balance">The meeting record</h1>
    <p class="text-body-large measure mt-4">
      Every match the archive holds between any two players, {MATCH_SEASONS_LABEL}.
      All {roster.length.toLocaleString("en-GB")} players who appear in the record
      are selectable, not just the ranked ones.
    </p>

    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <Select id="h2h-p1" label="First player" class="w-full" options={options} />
      <Select id="h2h-p2" label="Second player" class="w-full" options={options} />
    </div>

    <p class="note mt-4" id="h2h-status">Choose two players to see their record.</p>

    <section class="section hidden" id="h2h-result">
      <div class="section-head">
        <p class="text-kicker" id="h2h-heading">Meetings</p>
        <p class="text-note" id="h2h-summary"></p>
      </div>
      <div class="table-scroll">
        <table class="table table--tight">
          <thead>
            <tr>
              <th class="col-meta" scope="col">Date</th>
              <th class="col-meta col-hide-sm" scope="col">Tournament</th>
              <th class="col-meta col-hide-sm" scope="col">Round</th>
              <th class="col-meta" scope="col">Surface</th>
              <th class="col-name" scope="col">Winner</th>
              <th class="col-meta" scope="col">Score</th>
            </tr>
          </thead>
          <tbody id="h2h-rows"></tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<script>
  // The Select component puts the id on the <select> itself, not a wrapper.
  const p1 = document.getElementById("h2h-p1") as HTMLSelectElement | null;
  const p2 = document.getElementById("h2h-p2") as HTMLSelectElement | null;
  const status = document.getElementById("h2h-status")!;
  const result = document.getElementById("h2h-result")!;
  const rows = document.getElementById("h2h-rows")!;
  const heading = document.getElementById("h2h-heading")!;
  const summary = document.getElementById("h2h-summary")!;

  const cache = new Map<string, { matches: Match[] }>();
  interface Match { o: string; n: string; d: string; t: string; r: string; s: string; w: 0 | 1; c: string }

  const label = (sel: HTMLSelectElement) =>
    sel.options[sel.selectedIndex]?.label.split(" · ")[0] ?? "";

  const fmtDate = (d: string) =>
    /^\d{8}$/.test(d)
      ? new Date(`${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6, 8)}T00:00:00Z`)
          .toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })
      : d;

  async function load(id: string) {
    const hit = cache.get(id);
    if (hit) return hit;
    const res = await fetch(`/api/h2h/${id}.json`);
    if (!res.ok) throw new Error(`No record for ${id}`);
    const data = await res.json();
    cache.set(id, data);
    return data;
  }

  async function compare() {
    if (!p1 || !p2) return;
    const a = p1.value, b = p2.value;
    if (!a || !b) return;
    if (a === b) {
      result.classList.add("hidden");
      status.textContent = "Choose two different players.";
      return;
    }

    status.textContent = `Looking up ${label(p1)} v ${label(p2)}…`;
    try {
      const { matches } = await load(a);
      const meetings = (matches as Match[])
        .filter((m) => m.o === b)
        .sort((x, y) => y.d.localeCompare(x.d));

      const nameA = label(p1), nameB = label(p2);
      rows.textContent = "";

      if (meetings.length === 0) {
        result.classList.add("hidden");
        status.textContent = `${nameA} and ${nameB} never met in a tour-level match between 1991 and 2024.`;
        return;
      }

      const wonA = meetings.filter((m) => m.w === 1).length;
      heading.textContent = `${nameA} v ${nameB}`;
      summary.textContent = `${wonA}–${meetings.length - wonA} in ${meetings.length} meeting${meetings.length === 1 ? "" : "s"}`;

      for (const m of meetings) {
        const tr = document.createElement("tr");
        // Built with the DOM rather than interpolated markup, so a name
        // containing an apostrophe or an ampersand cannot break the page.
        const cells: [string, string][] = [
          ["col-meta num", fmtDate(m.d)],
          ["col-meta col-hide-sm", m.t],
          ["col-meta col-hide-sm", m.r],
          ["col-meta", m.s],
          ["col-name", m.w === 1 ? nameA : nameB],
          ["col-meta num", m.c],
        ];
        for (const [cls, text] of cells) {
          const td = document.createElement("td");
          td.className = cls;
          td.textContent = text;
          tr.append(td);
        }
        rows.append(tr);
      }

      status.textContent = "";
      result.classList.remove("hidden");
    } catch {
      result.classList.add("hidden");
      status.textContent = "Couldn't load that record. Check your connection and pick the players again.";
    }
  }

  p1?.addEventListener("change", compare);
  p2?.addEventListener("change", compare);
</script>
