---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import CountryFlag from "@/components/CountryFlag.astro";
import { career, meta } from "@/lib/clutch/data";
import { ARCHIVE_RANGE_LABEL, RANKINGS_AS_OF_LABEL } from "@/lib/archive";

const fmt = (n: number) => n.toLocaleString("en-GB");
const topClutch = career.slice(0, 5);

const contents = [
  {
    href: "/clutch",
    title: "The Clutch Index",
    blurb:
      "Who wins the points that decide matches, measured against what each player's ordinary play predicts.",
    meta: `${fmt(meta.careerQualifiers)} players · ${meta.seasons[0]}–${meta.seasons[1]}`,
  },
  {
    href: "/rankings",
    title: "Rankings",
    blurb: "Every published ATP ranking week of 2024, top to bottom.",
    meta: `As at the ${RANKINGS_AS_OF_LABEL}`,
  },
  {
    href: "/competitions",
    title: "Tournaments",
    blurb: "The tour calendar by level, from the Grand Slams down.",
    meta: "Compiled from match records",
  },
  {
    href: "/head-to-head",
    title: "Head to Head",
    blurb: "The complete meeting record between any two players in the archive.",
    meta: `${ARCHIVE_RANGE_LABEL}`,
  },
];
---

<Layout>
  <div class="page py-12">
    <p class="text-kicker">Established from the public record</p>
    <h1 class="text-display mt-2 text-balance">The Tennis Almanac</h1>

    <p class="text-body-large measure mt-5">
      A record of professional men's tennis from {ARCHIVE_RANGE_LABEL} — every
      tour-level match with its statistics, drawn from the public Sackmann
      dataset and kept here because the original disappeared.
    </p>

    <div class="dl--inline mt-8 border-y border-grid py-3">
      <div class="dl-row"><dt class="dl-term">Seasons</dt><dd class="dl-value">{meta.seasons[1] - meta.seasons[0] + 1}</dd></div>
      <div class="dl-row"><dt class="dl-term">Matches</dt><dd class="dl-value">{fmt(meta.matchesSeen)}</dd></div>
      <div class="dl-row"><dt class="dl-term">With full statistics</dt><dd class="dl-value">{fmt(meta.matchesUsed)}</dd></div>
      <div class="dl-row"><dt class="dl-term">Rankings frozen</dt><dd class="dl-value">30 Dec 2024</dd></div>
    </div>

    <!-- Contents -->
    <section class="section">
      <div class="section-head"><p class="text-kicker">Contents</p></div>
      <dl class="cells" style="grid-template-columns:1fr">
        {
          contents.map((c) => (
            <div class="cell flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <div>
                <a href={c.href} class="text-heading-3 link no-underline hover:underline">
                  {c.title}
                </a>
                <p class="text-body-small measure mt-1">{c.blurb}</p>
              </div>
              <span class="text-note shrink-0">{c.meta}</span>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- A taste of the data, rather than a description of it -->
    <section class="section">
      <div class="section-head">
        <p class="text-kicker">Most clutch, all-time</p>
        <p class="text-note"><a class="link" href="/clutch">Full index ›</a></p>
      </div>
      <div class="table-scroll">
        <table class="table table--tight">
          <thead>
            <tr>
              <th class="col-rank" scope="col">#</th>
              <th class="col-name" scope="col">Player</th>
              <th class="col-meta col-hide-sm" scope="col">Career</th>
              <th class="col-num" scope="col">Clutch</th>
            </tr>
          </thead>
          <tbody>
            {
              topClutch.map((p) => (
                <tr>
                  <td class="col-rank">{p.rank}</td>
                  <td class="col-name">
                    <span class="inline-flex items-baseline gap-1.5">
                      <CountryFlag countryCode={p.cc} size="small" />
                      {p.name}
                    </span>
                  </td>
                  <td class="col-meta col-hide-sm">{p.y0}–{p.y1}</td>
                  <td class="col-num font-semibold">{p.rating.toFixed(1)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Sources, as a first-class section rather than a footnote -->
    <section class="section">
      <div class="section-head"><p class="text-kicker">Sources &amp; limits</p></div>
      <div class="measure">
        <p class="text-body">
          <strong class="text-ink">Sources.</strong> All match records come from Jeff
          Sackmann's <em>tennis_atp</em> dataset, released under Creative Commons
          Attribution-NonCommercial-ShareAlike 4.0. This archive is non-commercial
          and is shared under the same licence. The upstream repository has since
          been removed from GitHub; what is held here is a preserved mirror.
        </p>
        <p class="text-body mt-4">
          <strong class="text-ink">Limits.</strong> Serve statistics begin in 1991,
          so earlier seasons are not held here. Rankings stop at the week of 30
          December 2024. There are no live scores on this site and there will not
          be. Doubles, qualifying and the women's tour are outside the dataset.
        </p>
      </div>
    </section>
  </div>
</Layout>
