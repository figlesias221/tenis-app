---
import { siteConfig } from "@/site.config";
import { ARCHIVE_RANGE_LABEL, RANKINGS_AS_OF_LABEL } from "@/lib/archive";
import Header from "@/components/Header.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string | undefined;
  articleDate?: string | undefined;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage,
  articleDate,
} = Astro.props;

const year = 2026;
---

<!doctype html>
<html lang={siteConfig.lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />

    <!-- The one webfont, preloaded so the swap happens before first paint. -->
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.url)} />}
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <meta property="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Sets the theme before first paint, so there is no flash. -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const dark = saved === "dark" || (!saved && prefersDark);
        document.documentElement.classList.toggle("dark", dark);
        // Match native scrollbars and form controls immediately.
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
      })();
    </script>
  </head>

  <body class="bg-paper text-ink-2 min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16">
      <div class="page">
        <div class="rule-heavy pt-6 pb-12">
          <div class="grid gap-8 md:grid-cols-3">
            <div>
              <p class="font-display text-lg font-semibold text-ink">
                {siteConfig.title}
              </p>
              <p class="text-note mt-2 max-w-xs">
                An archive of professional tennis results, {ARCHIVE_RANGE_LABEL}.
              </p>
            </div>

            <div>
              <p class="text-kicker">Sections</p>
              <ul class="mt-3 space-y-1.5">
                <li><a class="link text-sm" href="/rankings">Rankings</a></li>
                <li><a class="link text-sm" href="/competitions">Tournaments</a></li>
                <li><a class="link text-sm" href="/head-to-head">Head to Head</a></li>
                <li><a class="link text-sm" href="/clutch">Clutch Index</a></li>
              </ul>
            </div>

            <div>
              <p class="text-kicker">Sources &amp; method</p>
              <p class="text-note mt-3">
                Match and ranking records compiled by <strong class="text-ink-2"
                  >Jeff Sackmann</strong
                >, published as <em>tennis_atp</em> under
                <a
                  class="link"
                  href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
                  rel="license noopener"
                  target="_blank">CC BY-NC-SA 4.0</a
                >. This archive is non-commercial and shares alike.
              </p>
              <p class="text-note mt-2">
                Match data ends 2024. Rankings are frozen at the {RANKINGS_AS_OF_LABEL}.
                There are no live scores here.
              </p>
            </div>
          </div>

          <div class="rule mt-8 pt-4">
            <p class="text-note">
              © {year} · Not affiliated with the ATP, WTA or ITF.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
