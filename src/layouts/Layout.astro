---
import { siteConfig } from "@/site.config";
import { ARCHIVE_RANGE_LABEL, RANKINGS_AS_OF_LABEL } from "@/lib/archive";
import Header from "@/components/Header.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string | undefined;
  articleDate?: string | undefined;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage,
  articleDate,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a2230" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />

    <!-- Both faces preloaded: the type carries the design, so a swap would be
         visible. Archivo's width axis means the condensed display and the body
         text are one file. -->
    <link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/martian-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.url)} />}
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    <meta property="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>

  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1"><slot /></main>

    <footer class="mt-20 border-t-2 border-chalk">
      <div class="page py-8">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <p class="text-heading-4">{siteConfig.title}</p>
            <p class="text-note mt-2 max-w-[26ch]">
              An archive of professional tennis results, {ARCHIVE_RANGE_LABEL}.
            </p>
          </div>
          <div>
            <p class="text-kicker">Sections</p>
            <ul class="mt-3 space-y-1.5">
              <li><a class="link text-sm" href="/clutch">Clutch Index</a></li>
              <li><a class="link text-sm" href="/rankings">Rankings</a></li>
              <li><a class="link text-sm" href="/competitions">Tournaments</a></li>
              <li><a class="link text-sm" href="/head-to-head">Head to Head</a></li>
            </ul>
          </div>
          <div>
            <p class="text-kicker">Sources &amp; method</p>
            <p class="text-note mt-3">
              Match and ranking records compiled by <strong class="text-chalk-2">Jeff Sackmann</strong>,
              published as <em>tennis_atp</em> under
              <a class="link" href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="license noopener" target="_blank">CC BY-NC-SA 4.0</a>.
              This archive is non-commercial and shares alike.
            </p>
            <p class="text-note mt-2">
              Match data ends 2024. Rankings are frozen at the {RANKINGS_AS_OF_LABEL}.
              There are no live scores here.
            </p>
          </div>
        </div>
        <p class="text-note mt-7 border-t border-line pt-4">
          © 2026 · Not affiliated with the ATP, WTA or ITF.
        </p>
      </div>
    </footer>
  </body>
</html>
