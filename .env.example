# LiveTennisAPI (docs.livetennisapi.com). The FREE tier allows 100 calls a day,
# so this key is shared by every visitor through a KV cache - see
# src/lib/live/snapshot.ts. Locally, put it in .dev.vars instead, which is what
# wrangler reads; in production it is a Cloudflare secret.
LIVETENNIS_API_KEY=your_livetennisapi_key_here
